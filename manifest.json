{
  "manifest_version": 3,
  "name": "last-time",
  "version": "0.1.0",
  "description": "Muestra la fecha y hora de la última vez que escuchaste cada resumen de audio de NotebookLM.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"],
      "run_at": "document_idle",
      "css": ["src/styles.css"],
      "js": [
        "src/lib.js",
        "src/storage.js",
        "src/player-tracker.js",
        "src/selectors.js",
        "src/label-renderer.js",
        "src/content.js"
      ]
    }
  ]
}
