{
  "manifest_version": 3,
  "name": "last-time",
  "version": "0.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://notebook.google.com/*", "https://notebooklm.google.com/*"],
      "run_at": "document_idle",
      "css": ["src/styles.css"],
      "js": [
        "src/lib.js",
        "src/storage.js",
        "src/player-tracker.js",
        "src/selectors.js",
        "src/label-renderer.js",
        "src/content.js"
      ]
    }
  ]
}
